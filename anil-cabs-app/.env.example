# Frontend environment
# Keep /api for local development; Vite proxies requests to the backend.
# Set this to the deployed backend URL in production.
VITE_API_BASE_URL=/api
VITE_WHATSAPP_NUMBER=919014726337

# Backend environment
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173

# MySQL credentials for docker compose. Copy this file to .env and set private values.
DB_USERNAME=anilcabs
DB_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
